@model Notes.Identity.Models.LoginViewModel
<head>
    <link href="@Url.Content("~/styles/app.css")" rel="stylesheet" type="text/css"/> 
</head>
<form asp-controller="Auth" asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl"/>
        <div class="header">Login</div>
        <div class="block">
            <label>Login</label>
            <input asp-for="Login" class="input" />
            <span asp-validation-for="Login"></span>
        </div>
        <div class="block">
            <label>Password</label>
            <input asp-for="Password" class="input" type="password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="block">
            <button type="submit" class="button">Sign In</button>
        </div>
    <a href="@Url.Action("Register", "Register", new { returnUrl = Model.ReturnUrl })" class="switch-button">Register</a>
</form>
