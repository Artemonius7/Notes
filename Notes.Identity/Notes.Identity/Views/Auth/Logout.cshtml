@model Notes.Identity.Models.LogoutViewModel
<head>
    <link href="@Url.Content("~/styles/app.css")" rel="stylesheet" type="text/css"/>
</head>
<form asp-controller="Logout" asp-action="Logout" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="header">Logout</div>
    <div class="button">
        <button type="submit" class="button">Log Out</button>
    </div>
    <a href="@Url.Action("Logout", "Logout", new { returnUrl = Model.ReturnUrl })" class="switch-button">Logout</a>
</form>