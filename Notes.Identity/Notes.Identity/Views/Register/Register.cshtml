@model Notes.Identity.Models.RegisterViewModel
<head>
    <link href="@Url.Content("~/styles/app.css")" rel="stylesheet" type="text/css" />
</head>
<form asp-controller="Register" asp-action="Register" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="header">Register</div>

    <div asp-validation-summary="All" style="color: red; margin-bottom: 10px;"></div>

    <div class="block">
        <label>Login</label>
        <input asp-for="Login" class="input" />
        <span asp-validation-for="Login"></span>
    </div>
    <div class="block">
        <label>Password</label>
        <input asp-for="Password" class="input" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div class="block">
        <label>Confirm Password</label>
        <input asp-for="ConfirmPassword" class="input" type="password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <div class="button">
        <button type="submit" class="button">Sign Up</button>
    </div>
     
    <a href="@Url.Action("Login", "Auth", new { returnUrl = Model.ReturnUrl })" class="switch-button">Login</a>
</form>